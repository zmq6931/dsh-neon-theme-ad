{
  "name": "dsh-neon-theme-ad",
  "version": "0.20.1",
  "type": "module",
  "description": "Neon theme engine for the DSH Web GUI: animated code-drawn backdrops, a breathing neon window frame, a glowing composer ring, ten skins with category rotation and time-of-day switching, and a wallpaper shelf (Wallhaven, Bing daily, Picsum, Mixkit live video, Sakugabooru anime highlights) with a local caching proxy, playlists and host-side settings persistence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmq6931/dsh-neon-theme-ad.git"
  },
  "homepage": "https://github.com/zmq6931/dsh-neon-theme-ad#readme",
  "bugs": {
    "url": "https://github.com/zmq6931/dsh-neon-theme-ad/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "neon",
    "wallpaper"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
